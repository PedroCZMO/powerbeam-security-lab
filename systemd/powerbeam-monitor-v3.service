[Unit]
Description=PowerBeam Security Monitor V3 - Parallel Validation
Wants=rsyslog.service
After=rsyslog.service

[Service]
Type=oneshot

User=powerbeam-monitor
Group=powerbeam-monitor

ExecStart=/usr/bin/python3 -B /opt/powerbeam-monitor-v3/scripts/stateful_monitor_v3.py --log-dir /var/log/powerbeam --state /var/lib/powerbeam-monitor/parallel-v3/state-v3.json --output /var/lib/powerbeam-monitor/parallel-v3/alerts-v3.jsonl

UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

StateDirectory=powerbeam-monitor
StateDirectoryMode=0700

TimeoutStartSec=120
