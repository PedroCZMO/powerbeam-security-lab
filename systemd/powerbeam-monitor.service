[Unit]
Description=PowerBeam Security Monitor - SOC Detection
After=rsyslog.service

[Service]
Type=oneshot

User=powerbeam-monitor
Group=powerbeam-monitor

ExecStart=/usr/bin/bash /opt/powerbeam-monitor/scripts/run_monitor.sh

UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

StateDirectory=powerbeam-monitor
StateDirectoryMode=0700

TimeoutStartSec=120
